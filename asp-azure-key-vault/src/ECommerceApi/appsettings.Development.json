{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "KeyVaultUri": "https://kv-ecommerce-dev-mh.vault.azure.net/",

  // ── Secrets stored in Azure Key Vault (in Production) ────────────────────────
  // Double-dash (--) is the Key Vault secret name separator convention.
  // In Key Vault the secret names are: SqlServer--ConnectionString, Jwt--SigningSecret, etc.

  "SqlServer": {
    "ConnectionString": "Server=localhost;Database=EComDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Issuer": "ECommerceApi",
    "Audience": "ECommerceApiUsers",
    "SigningSecret": "dev-replace-with-a-strong-secret-at-least-32-chars!!"
  },

  "Smtp": {
    "Host": "smtp.mailtrap.io",
    "Port": "587",
    "Username": "your-mailtrap-username",
    "Password": "your-mailtrap-password",
    "FromEmail": "noreply@ecommerce.local",
    "FromName": "ECommerce Store"
  }
}
